# Shell-compatible configuration for beverin.sbatch and run_cluster.sh.
# Variant: MCP STARTUP SMOKE -- 120 agents on ONE node, which is the only condition that reproduces
# the failure it exists to check. On 604487 45 of 121 agents came up with mcp_servers status
# "failed", and the failures were a BAND by worker index (0/20 for 0-19, 20/20 for 60-79, 1/20 for
# 100-119): the cost is concurrent spawns, not elapsed time. A failed server leaves the agent with
# NO optarena tools -- it still runs, burns its whole budget, invents a `Submit` tool and exits
# reporting success, so the loss never shows up as an error.
#
# What this smoke gates: the START_GATE semaphore and the relaunch loop in agent_driver.py, which
# the pending oss120b arms will pick up whether or not anyone has run them. Read the result with:
#   grep -l '"status":"failed"' <run>/agents/node-0/problem-*/claude.log | wc -l
#   grep -c mcp_attempts= <slurm-out>
# Ten agents cannot show either number, which is why this is not the llr4 smoke with a bigger list.
#
#   CLUSTER_ENV_FILE=$PWD/.env.smoke-mcp-storm sbatch --nodes=5 --time=02:00:00 beverin.sbatch
# No --account: beverin schedules root, a-g200 and a-g34 identically.

# Slurm role sizes. The allocation must equal their sum: 5 nodes.
INFERENCE_NODES=1
AGENT_NODES=1
JUDGE_NODES=3
GPUS_PER_NODE=4
# replicas: one standalone TP4 vLLM per inference node behind LiteLLM round-robin.
INFERENCE_MODE=replicas

# Container Engine environments installed in ~/.edf (names, not .toml paths).
INFERENCE_CE_ENV=rocm723-vllm-0.27.1-pytorch211-ofi
AMD_CE_ENV=optarena-amd-mi300-v4

# Shared paths visible at the same location from every Beverin node.
HPCAGENT_BENCH_REPO=
RUN_ROOT=${SCRATCH:-/iopsstor/scratch/cscs/$USER}/hpcagent-bench-runs
PROBLEMS_FILE=problems-llr6-c.jsonl
# The campaign arm every recorded row is attributed to: agent_driver.py composes
# $OPTARENA_RUN_ID from it, and it is the ONLY arm label that reaches the judge DB.
CAMPAIGN_ARM=smoke-mcp-storm

# Distributed vLLM service.
VLLM_MODEL=openai/gpt-oss-120b
VLLM_SERVED_MODEL=optarena-vllm
VLLM_PORT=8000
VLLM_MASTER_PORT=29500
VLLM_READY_TIMEOUT_SECONDS=2400
# Quoted: the launcher sources this under `set -a`, so an unquoted value with spaces runs its
# second word as a command -- and under `set -euo pipefail` that aborts the job before it starts.
# Flag-for-flag the serve set that passed the claude roundtrip gate (job 584004): bf16 is the
# COMPUTE dtype (weights stay gpt_oss_mxfp4), and the tool/reasoning parsers are what let
# claude's tool calls parse at all. The bare-MXFP4 serve path OOM-killed the engine (584033).
VLLM_EXTRA_ARGS="--dtype bfloat16 --load-format safetensors --safetensors-load-strategy prefetch --generation-config vllm --enable-auto-tool-choice --tool-call-parser openai --reasoning-parser openai_gptoss --max-model-len 131072 --gpu-memory-utilization 0.70 --max-num-seqs 128"
VLLM_API_KEY=EMPTY

# Judge service. /search is served by the router itself; every grading route is forwarded to the
# benchmark judge (`hpcagent-bench serve`), which run_cluster.sh starts on the same node.
JUDGE_PORT=8800
JUDGE_READY_TIMEOUT_SECONDS=300
# The forwarded-to judge. Loopback only -- the router on JUDGE_PORT is the agent-visible surface.
JUDGE_UPSTREAM_PORT=8801
JUDGE_UPSTREAM_READY_TIMEOUT_SECONDS=300
# A forwarded grade compiles, runs and times a submission, so minutes is normal.
JUDGE_UPSTREAM_TIMEOUT_SECONDS=5400
# What the AGENT waits for that same grade; unset it defaults to 300 in
# containers/agent/tools/http_json.py and the agent walks away from work budgeted 30 minutes,
# leaving the judge holding a device slot for a client that is gone. Keep the two numbers equal.
JUDGE_TIMEOUT_SECONDS=1800
# What a submission may carry: source, py-binding, library, any. `source` is what enforces a
# language track -- it refuses anything but a compiled-language source file named after the kernel.
JUDGE_INPUT_MODE=source
# Grading concurrency, FROZEN identically for every arm (a code-default change must not move it
# mid-campaign). 4 slots; each grade holds one slot for builds AND both timed sections, so the
# speedup ratio is measured back-to-back under the same ambient load (585108: judge load1 <= 1.4).
HPCAGENT_BENCH_JUDGE_GPUS_PER_NODE=4
HPCAGENT_BENCH_JUDGE_CPU_SLOTS_PER_NODE=0

# Recording. The harness default is record.enabled=false, which would grade every submission and
# write NOTHING for merge_results.py to merge. `set -a` carries this to every judge rank.
HPCAGENT_BENCH_RECORD_ENABLED=true
SERPAPI_API_KEY=
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_MAX_PAGES=3
WEBSEARCH_TIMEOUT_SECONDS=60

# Agent batch: 120 workers on the one agent node -- the number IS the test. They stripe over
# the 3 judge ranks by problem index; grading backlog is expected and does not affect the signal,
# which is read off each agent's init event before it does any work.
KERNELS=
AGENTS_PER_NODE=120
AGENT_READY_TIMEOUT_SECONDS=2400
CLAUDE_BIN=claude
CLAUDE_MODEL=optarena-llm
# DB self-description: the real served model, recorded as attempts.optimizer. CLAUDE_MODEL must
# stay the served alias -- LiteLLM routes on it -- so agent_driver.py prefers this when set.
OPTARENA_OPTIMIZER=openai/gpt-oss-120b
# Held at the arm value so the turn cap never binds: on sweep-1 a cap of 40 censored 52% of the
# agents, i.e. the cap became the limiter instead of the budget regime below.
CLAUDE_MAX_TURNS=100000
# Compaction threshold under the 131072 serve wall, as the arms set it.
CLAUDE_AUTOCOMPACT=100000
# Hard per-agent wall clock (seconds); agent_driver kills the claude process past it. The soft
# half is the --note sentence in the task text above. Shorter than the arms' 7200 on purpose --
# this run is a plumbing check, not a measurement -- and it fits the 2-hour job after the
# ~15-minute vLLM startup (measured on 585019). AGENT_MAX_TOKENS is the arm value: it is the
# other limiter, and rc 125 vs rc 124 is how the run says which one tripped.
AGENT_TIMEOUT_SECONDS=1500
AGENT_MAX_TOKENS=10000000
LITELLM_PORT=4000
LITELLM_MASTER_KEY=EMPTY
LANGUAGE=c
